<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1: el mismo binario lo consume el servidor (net10.0) y Unity. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Avelora.Net</RootNamespace>
    <AssemblyName>Avelora.Net</AssemblyName>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- LiteNetLib queda encerrada en este proyecto: la simulación no conoce UDP ni tipos de la
         librería, solo las interfaces de abajo (plan del servidor §4). -->
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

</Project>
